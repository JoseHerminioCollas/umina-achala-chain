# Copy to .env.testnet / .env.mainnet (git-ignored) and fill in
OPERATOR_ID=
OPERATOR_KEY=
TREASURY_ID=
# Only when TREASURY_ID is not OPERATOR_ID (the treasury must sign)
TREASURY_KEY=
ADMIN_KEY=
SUPPLY_KEY=
FEE_SCHEDULE_KEY=
PAUSE_KEY=
WIPE_KEY=
# Royalty fallback fee in HBAR (about USD 3, converted on the day the token is
# created; record the amount and rate on umina-achala-chain#6). No metadata key:
# NFT metadata is immutable.
FALLBACK_FEE_HBAR=
UMINA_TOKEN_ID=
# The Achala (jewelry) token, created with createToken.js --token achala.
# Minting an Achala also needs UMINA_TOKEN_ID and TREASURY_ID (its stones)
ACHALA_TOKEN_ID=
HCS_TOPIC_ID=
HCS_DISPLAY_TOPIC_ID=
# The topics' submit and admin keys (umina-achala-chain#9). createTopic.js
# requires both. On testnet they can be the same as OPERATOR_KEY (one key for
# every role); use separate keys on mainnet. MINT and SALE messages are signed
# with HCS_SUBMIT_KEY when it is set.
HCS_SUBMIT_KEY=
HCS_ADMIN_KEY=
# Pinata API key (JWT) limited to pinning: it needs both pinFileToIPFS (images,
# PDFs, GLB files) and pinJSONToIPFS (the metadata)
PINATA_JWT=
# Consignment (testnet only): test accounts that stand in for a merchant and a
# buyer. In production they sign in their own wallets.
MERCHANT_ID=
MERCHANT_KEY=
BUYER_ID=
BUYER_KEY=
