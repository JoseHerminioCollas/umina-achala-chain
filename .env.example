# Copy to .env.testnet / .env.mainnet (git-ignored) and fill in
OPERATOR_ID=
OPERATOR_KEY=
TREASURY_ID=
# Only when TREASURY_ID is not OPERATOR_ID (the treasury must sign)
TREASURY_KEY=
ADMIN_KEY=
SUPPLY_KEY=
FEE_SCHEDULE_KEY=
PAUSE_KEY=
WIPE_KEY=
# Optional, defaults to ADMIN_KEY
METADATA_KEY=
UMINA_TOKEN_ID=
HCS_TOPIC_ID=
# Pinata API key (JWT) limited to pinning JSON
PINATA_JWT=
