{
  "title": "Umiña Stone HIP-412 Metadata",
  "type": "object",
  "required": ["name", "creator", "description", "image", "format", "metadata_version", "properties", "files", "attributes"],
  "properties": {
    "name": { "type": "string" },
    "creator": { "type": "string" },
    "description": { "type": "string" },
    "image": { "type": "string", "pattern": "^ipfs://.*" },
    "type": { "type": "string" },
    "format": { "type": "string", "enum": ["HIP412@2.0.0"] },
    "metadata_version": { "type": "string" },

    "properties": {
      "type": "object",
      "required": ["stone_id", "stone_type", "specimen_form", "hs_code", "jurisdiction", "legal_uri", "vendor_ruc", "mining_concession", "reinfo_id"],
      "properties": {
        "stone_id": {
          "type": "string",
          "pattern": "^UMINA-\\d{4}-[A-Z]{2}-\\d{2,}$",
          "description": "UMINA-YYYY-XX-NN, for example UMINA-2026-CH-03"
        },
        "stone_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "An id from schema/stone-types.json; metadataValidator.js checks it is in the list, not deprecated and not a fossil (umina-achala-chain#14)"
        },
        "materials": {
          "type": "array",
          "minItems": 1,
          "description": "For a specimen of several materials, one entry per material, e.g. quartz (host) with gold (inclusion). Each stone_type is an id from schema/stone-types.json.",
          "items": {
            "type": "object",
            "required": ["stone_type", "role"],
            "additionalProperties": false,
            "properties": {
              "stone_type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "role": { "type": "string", "enum": ["host", "inclusion"] },
              "form": { "type": "string", "enum": ["crystal", "leaf", "wire", "nugget"] },
              "weight_g": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "specimen_form": { "type": "string", "enum": ["natural", "worked", "crafted"] },
        "hs_code": { "type": "string" },
        "jurisdiction": { "type": "string" },
        "legal_uri": { "type": "string", "format": "uri" },
        "vendor_ruc": {
          "type": "string",
          "pattern": "^(10|15|17|20)\\d{9}$",
          "description": "11-digit SUNAT RUC; metadataValidator.js also checks its check digit (umina-achala-chain#5)"
        },
        "artisan_rna": { "type": "string" },
        "mining_concession": {
          "type": "string",
          "pattern": "^\\d{9}$",
          "description": "INGEMMET Código Único of the mining concession, 9 digits, e.g. 010253815 (umina-achala-chain#5)"
        },
        "reinfo_id": {
          "type": "string",
          "pattern": "^(10|15|17|20)\\d{9}$",
          "description": "REINFO is tracked by the miner's RUC: 11 digits; metadataValidator.js also checks its check digit (umina-achala-chain#5)"
        },
        "reinfo_status": { "type": "string", "description": "REINFO status at mint. Later changes are HCS events (umina-achala-chain#10), since metadata is immutable." },
        "cod_reference": { "type": "string" },
        "standard_compliance": { "type": "string" },
        "compliance_proof_hcs": { "type": "string", "description": "Transaction ID of the COMPLIANCE event posted to the provenance topic before the metadata was pinned (set by the mint script)" },
        "audit_log_uri": { "type": "string" },
        "last_regulatory_check": { "type": "string", "format": "date-time", "description": "Last regulatory check before mint. Later checks are HCS events." },
        "vuce_xml_hash": { "type": "string" },
        "sunafil_payroll_verified": { "type": "boolean" },
        "census_status": { "type": "string" },
        "sinceramiento_timestamp": { "type": "string", "format": "date-time" },
        "export_status": {
          "type": "object",
          "description": "Export state at mint. Export and custody after mint are HCS events (EXPORT, TRANSFER, DELIVERED), since metadata is immutable; current_location is no longer part of it (umina-achala-chain#14).",
          "required": ["is_exported", "export_permit_id"],
          "additionalProperties": false,
          "properties": {
            "is_exported": { "type": "boolean" },
            "export_timestamp": { "type": ["string", "null"], "format": "date-time" },
            "export_permit_id": { "type": "string" }
          }
        },
        "store_receipt_hash": { "type": "string" },
        "sinceramiento_status": { "type": "string", "description": "Sinceramiento status at mint. Later changes are HCS events." },
        "inei_census_id": { "type": "string" },
        "hcs_compliance_topic": { "type": "string" }
      }
    },

    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["uri", "type"],
        "properties": {
          "uri": { "type": "string", "pattern": "^ipfs://.*" },
          "type": { "type": "string" },
          "is_default_file": { "type": "boolean" },
          "checksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of the pinned file, set on each photo master so a buyer can check the archived photo was not altered (umina-achala-chain#7)"
          },
          "metadata": { "type": "object" }
        }
      }
    },

    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trait_type", "value"],
        "properties": {
          "trait_type": { "type": "string" },
          "value": { "type": ["string", "number", "boolean"] }
        }
      }
    }
  }
}
